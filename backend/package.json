{
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --all --check-coverage --lines 80 --branches 80 --functions 80 --statements 80 --reporter text --reporter html --reporter lcov node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node": "^25.9.0",
    "node-fetch": "^3.3.2"
  },
  "c8": {
    "include": ["app.js", "server.js", "controllers/**/*.js", "routes/**/*.js", "utils/**/*.js", "config/**/*.js"]
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nock": "^15.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
